# ===== Secrets PocketFlow — template =====
# Copier vers .env et remplir avec les valeurs réelles.
# NE JAMAIS commiter le .env rempli.

# --- Tokens agents ZeroClaw ---
PF_AGENT_TOKEN_SCRIPTWRITER=
PF_AGENT_TOKEN_ASSETFINDER=

# --- OpenCode Go (GLM 5.3 Flash, scriptwriter alt) ---
PF_OPENCODE_API_KEY=

# --- TikHub (API vidéos/réseaux sociaux) ---
TIKHUB_API_KEY=

# --- CapBypass (résolution CAPTCHA, secours fetch navigateur) ---
CAPBYPASS_API_KEY=

# --- Telegram (bot de validation) ---
PF_TG_BOT_TOKEN=

# --- OpenRouter (décisions JEV / headcount garde-fou) ---
OPENROUTER_API_KEY=